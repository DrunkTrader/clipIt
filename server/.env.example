# Server Configuration
PORT=8080

# Download Directory (absolute path)
DOWNLOAD_DIR=/app/downloads

# File Cleanup TTL in seconds (default: 1 hour)
DOWNLOAD_TTL_SECONDS=3600

# Allowed CORS Origins (comma-separated)
ALLOWED_ORIGINS=http://localhost:3000,https://yourdomain.com

# Base URL for download links (optional, defaults to request base_url)
BASE_URL=http://localhost:8080

# Maximum clip duration in seconds (default: 600 = 10 minutes)
MAX_CLIP_SECONDS=600

# Maximum timecode value in seconds (default: 86400 = 24 hours)
MAX_TIMECODE_SECONDS=86400
